# Optional. If unset, the app uses an in-memory store seeded with 4 Qatar listings.
# To enable Firestore-backed persistence, copy this file to `.env` and fill in values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
